# I really don't like how light ghostty renders fonts by default.
# This configuration fixes it, albeit only on macos:
font-thicken = true
font-thicken-strength = 50
macos-option-as-alt = left
mouse-hide-while-typing = true

window-theme = system

font-family = Berkeley Mono
font-family-bold = Berkeley Mono Bold
font-family-italic = Berkeley Mono Oblique
font-family-bold-italic = Berkeley Mono Bold
font-style = Regular

theme = light:Monokai Pro Light,dark:Monokai Pro

font-size = 13
adjust-cell-height = 6 

window-width = 144
window-height = 40
